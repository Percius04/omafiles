# Maintainer: Josema <josema@example.com>
pkgname=omafiles
pkgver=0.9.3
pkgrel=2
pkgcommit=67f0bfdb3e0279800900f5089dff963a75047f9d
pkgdesc="A high-performance, native Qt6 file manager designed around the DHH philosophy"
arch=('x86_64')
url="https://github.com/Percius04/omafiles"
license=('MIT')
# qt6-webengine provides Qt6::Pdf (libQt6Pdf.so) on Arch -- CMakeLists.txt's
# `find_package(Qt6 REQUIRED COMPONENTS ... Pdf ...)` fails to configure
# without it (P0-5, forensic audit 2026-08-16).
# Runtime command owners verified with local pacman metadata. Python/GObject and
# xdg-desktop-portal are required by the shipped FileChooser D-Bus backend;
# udisks2/util-linux and gtk3 back app commands used by core workflows.
# qt6-svg renders PathSvg controls; wl-clipboard handles external clipboard
# import; zip/unzip/tar are direct, non-fallback archive commands.
depends=('qt6-base' 'qt6-declarative' 'qt6-5compat' 'qt6-webengine' 'qt6-svg'
         'glib2' 'python-gobject' 'xdg-desktop-portal' 'xdg-utils' 'udisks2'
         'util-linux' 'gtk3' 'wl-clipboard' 'zip' 'unzip' 'tar')
optdepends=('desktop-file-utils: refresh the desktop entry cache after opt-in integration'
            'libnotify: desktop notifications'
            'ffmpegthumbnailer: video thumbnails'
            'gvfs: remote filesystem mounts'
            '7zip: browse 7z archives'
            'unrar: browse RAR archives'
            'plocate: indexed global search')
makedepends=('cmake' 'ninja' 'git')
# Pin the tested v0.9.3 source commit. Unlike the old recipe, this cannot
# silently package an earlier tag while release fixes live only on master.
source=("${pkgname}::git+${url}.git#commit=${pkgcommit}")
sha256sums=('SKIP') # VCS source is immutable through the full commit pin above.

build() {
  cd "${pkgname}"
  # CMAKE_INSTALL_PREFIX alone does NOT control where this project installs --
  # OMAFILES_{BIN,DATA,QML}_INSTALL_DIR are separate CACHE variables that
  # default to $HOME/.local/... for the documented no-root per-user dev
  # workflow. Without overriding them here, `DESTDIR="$pkgdir" cmake --install`
  # would write into the PACKAGE BUILDER's own home directory instead of
  # staging under $pkgdir/usr/..., breaking makepkg entirely (P0-5, forensic
  # audit 2026-08-16).
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=ON \
    -DOMAFILES_BIN_INSTALL_DIR=/usr/bin \
    -DOMAFILES_DATA_INSTALL_DIR=/usr/share \
    -DOMAFILES_QML_INSTALL_DIR=/usr/lib/qt6/qml
  cmake --build build
}

check() {
  cd "${pkgname}"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build

  # Test execution creates Python bytecode in the source tree; Qt also emits a
  # build-only QML directory map. Neither belongs in the runtime package.
  find "${pkgdir}/usr/share/omafiles" -type d -name __pycache__ -prune -exec rm -rf {} +
  rm -f "${pkgdir}/usr/lib/qt6/qml/Omafiles/Backend/omafiles-backend_qml_module_dir_map.qrc"
}
